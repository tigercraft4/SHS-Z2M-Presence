		(exclude_from_sim no) (at 10 10 0)
		(effects (font (size 2 2))) (uuid "b2c3d4e5-txt1-0001-0001-000000000001"))

	(text "UART assignments (firmware-compatible with v1):\nIO4 = UART1_TX → LD2410C RX\nIO5 = UART1_RX ← LD2410C TX\nIO18 = UART0_TX → LD2450 RX\nIO19 = UART0_RX ← LD2450 TX\nIO12/IO13 = USB D-/D+ (native USB)"
		(exclude_from_sim no) (at 10 115 0)
		(effects (font (size 1.2 1.2))) (uuid "b2c3d4e5-txt2-0001-0001-000000000001"))

	(text "Power: VBUS(5V) → AP2112K → 3.3V\nU2/U3 radar modules on +5V direct\nU1 ESP32 on +3.3V (LDO output)\nCC1/CC2: 5.1k pull-down for USB-C 5V source\nC9 22uF bulk cap on VBUS (Espressif ref schematic)"
		(exclude_from_sim no) (at 10 125 0)
		(effects (font (size 1.2 1.2))) (uuid "b2c3d4e5-txt3-0001-0001-000000000001"))

	(text "LEDs:\nLED1 (green) = Status/Zigbee via IO2 + R5 330R\nLED2 (red)   = Power OK on +3V3 + R6 330R\n\nTest Points (TP1-TP8):\nTP1=+5V  TP2=+3V3  TP3=GND\nTP4=UART1_TX  TP5=UART1_RX\nTP6=UART0_TX  TP7=UART0_RX  TP8=ESP_EN\n\nMounting Holes: H1-H4 M3 (3.2mm drill)"
		(exclude_from_sim no) (at 10 133 0)
		(effects (font (size 1.2 1.2))) (uuid "b2c3d4e5-txt4-0001-0001-000000000001"))

