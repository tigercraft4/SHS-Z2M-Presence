(footprint "LD2450"
  (version 20240108)
  (generator "pcbnew")
  (generator_version "8.0")
  (layer "F.Cu")
  (descr "HLK-LD2450 24GHz mmWave Multi-Target Tracking Sensor, 8 pins THT 2x4, 2.0mm pitch, 44x15mm. Connector on LEFT short edge.")
  (tags "LD2450 mmWave radar tracking HLK 24GHz")
  (attr through_hole)

  (property "Reference" "U3"
    (at 0 -10 0)
    (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15)))
  )
  (property "Value" "LD2450"
    (at 0 10 0)
    (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15)))
  )

  ; Board outline: 44x15mm centred at 0,0
  (fp_rect
    (start -22 -7.5)
    (end 22 7.5)
    (stroke (width 0.1) (type default))
    (fill none)
    (layer "F.Fab")
  )

  ; Courtyard
  (fp_rect
    (start -22.75 -8.25)
    (end 22.75 8.25)
    (stroke (width 0.05) (type default))
    (fill none)
    (layer "F.CrtYd")
  )

  ; Silk outline
  (fp_rect
    (start -22.25 -7.75)
    (end 22.25 7.75)
    (stroke (width 0.15) (type default))
    (fill none)
    (layer "F.SilkS")
  )

  ; Antenna side marker (right short edge)
  (fp_line (start 18 -5) (end 22 -5)
    (stroke (width 0.15) (type default)) (layer "F.SilkS"))
  (fp_text user "ANTENNA"
    (at 17 0 0)
    (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )

  ; Connector side marker (left short edge)
  (fp_text user "CON"
    (at -20 0 0)
    (layer "F.SilkS")
    (effects (font (size 0.8 0.8) (thickness 0.12)))
  )

  ; Pin 1 indicator dot (near 5V square pad)
  (fp_circle
    (center -15.92 -5)
    (end -15.42 -5)
    (stroke (width 0.15) (type solid))
    (fill solid)
    (layer "F.SilkS")
  )

  ; Pin labels on F.Fab
  (fp_text user "5V"  (at -15.92 -5.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "3V3" (at -15.92 -3.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "PA9" (at -15.92 -1.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "GND" (at -15.92  0.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "RX"  (at -17.92 -5.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "TX"  (at -17.92 -3.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "DP"  (at -17.92 -1.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))
  (fp_text user "DM"  (at -17.92  0.5 0) (layer "F.Fab") (effects (font (size 0.5 0.5) (thickness 0.08))))

  ; Right column: 5V(1) 3V3(5) PA9(6) GND(4)  x=-16, y=-3.5 -1.5 +0.5 +2.5
  (pad "1" thru_hole rect
    (at -16 -3.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
  (pad "5" thru_hole circle
    (at -16 -1.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
  (pad "6" thru_hole circle
    (at -16 0.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
  (pad "4" thru_hole circle
    (at -16 2.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )

  ; Left column: RX(2) TX(3) DP(7) DM(8)  x=-18, y=-3.5 -1.5 +0.5 +2.5
  (pad "2" thru_hole circle
    (at -18 -3.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
  (pad "3" thru_hole circle
    (at -18 -1.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
  (pad "7" thru_hole circle
    (at -18 0.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
  (pad "8" thru_hole circle
    (at -18 2.5)
    (size 1.8 1.8)
    (drill 0.9)
    (layers "*.Cu" "*.Mask")
  )
)
