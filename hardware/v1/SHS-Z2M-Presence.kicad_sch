	)
	(text "LD2450 (Multi-Target) -> ESP32 UART0\nPin1 VCC (5V)\nPin2 RX <- GPIO18 (UART0_TX, ESP32 TX)\nPin3 TX -> GPIO19 (UART0_RX, ESP32 RX)\nPin4 GND"
